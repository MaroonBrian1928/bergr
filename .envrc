# Settings for the justfile. Put personal overrides in .envrc.local (not committed), e.g.:
#   export HIRTE_DEVICE=00000000-0000000000000000   # from `just devices`
#   To build with your own Apple developer team (Xcode → Settings → Accounts):
#   export HIRTE_TEAM=XXXXXXXXXX
#   export HIRTE_BUNDLE_ID_PREFIX=com.example
#   export HIRTE_SIMULATOR="iPhone 17 Pro"
#   For `just archive true` without Xcode's account sign-in (which expires), an App Store
#   Connect API key (App Store Connect → Users and Access → Integrations → Keys, role App Manager):
#   export HIRTE_ASC_KEY_PATH=~/.appstoreconnect/AuthKey_XXXXXXXXXX.p8
#   export HIRTE_ASC_KEY_ID=XXXXXXXXXX
#   export HIRTE_ASC_ISSUER_ID=00000000-0000-0000-0000-000000000000
export HIRTE_SIMULATOR="${HIRTE_SIMULATOR:-iPhone 17 Pro}"

source_env_if_exists .envrc.local
