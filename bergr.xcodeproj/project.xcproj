      },
    }, {
      "name": "bergrTests",
      "id": "E9102D363097E5CD000033A3",
      "product": "Products/bergrTests.xctest",
      "product-type": "bundle.unit-test",
      "test-host-target": "bergr",
      "dependencies": [
        "bergr",
      ],
      "build-phases": [
        "compile-sources",
        "frameworks",
        "resources",
      ],
      "build-settings": {
        "BUNDLE_LOADER": "$(TEST_HOST)",
        "CODE_SIGN_STYLE": "Automatic",
        "CURRENT_PROJECT_VERSION": "2",
        "GENERATE_INFOPLIST_FILE": "YES",
        "MARKETING_VERSION": "0.3.0",
