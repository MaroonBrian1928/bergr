{
  "default-configuration": "Release",
  "configurations": [
    "Debug",
    "Release",
  ],
  "localizations": {
    "development": "en",
    "supported": [
      "Base",
    ],
  },
  "packages": [
    {
      "kind": "local",
      "path": "HerdrKit",
    }, {
      "kind": "local",
      "path": "MacKit",
    },
  ],
  "files": [
    { "kind": "folder", "path": "bergr", "target-membership": [ "bergr", "bergrMac" ] },
    { "kind": "folder", "path": "bergrIOS", "target-membership": [ "bergr" ] },
    { "kind": "folder", "path": "bergrMac", "target-membership": [ "bergrMac" ] },
    { "kind": "folder", "path": "Shared", "target-membership": [ "BergrLiveActivity", "BergrNotificationService", "bergr", "bergrMac" ] },
    { "kind": "folder", "path": "SharedIOS", "target-membership": [ "BergrLiveActivity", "BergrNotificationService", "bergr" ] },
    { "kind": "folder", "path": "BergrLiveActivity", "target-membership": [ "BergrLiveActivity" ] },
    { "kind": "folder", "path": "BergrNotificationService", "target-membership": [ "BergrNotificationService" ] },
    { "kind": "folder", "path": "bergrTests", "target-membership": [ "bergrTests" ] },
    { "kind": "folder", "path": "bergrUITests", "target-membership": [ "bergrUITests" ] },
    {
      "kind": "group",
      "name": "Products",
      "children": [
        { "path": "<PRODUCTS>/bergr.app", "id": "E9102D2A3097E5CC000033A3", "type": "wrapper.application", "index": false },
        { "path": "<PRODUCTS>/Bergr.app", "id": "E9102D2B3097E5CC000033A3", "type": "wrapper.application", "index": false },
        { "path": "<PRODUCTS>/BergrLiveActivity.appex", "id": "E9102D503097E5CE000033A3", "type": "wrapper.app-extension", "index": false, "target-membership": [ "bergr/copy/Embed Foundation Extensions" ] },
        { "path": "<PRODUCTS>/BergrNotificationService.appex", "id": "E9102D613097E5CE000033A3", "type": "wrapper.app-extension", "index": false, "target-membership": [ "bergr/copy/Embed Foundation Extensions" ] },
        { "path": "<PRODUCTS>/bergrTests.xctest", "id": "E9102D373097E5CD000033A3", "type": "wrapper.cfbundle", "index": false },
        { "path": "<PRODUCTS>/bergrUITests.xctest", "id": "E9102D413097E5CD000033A3", "type": "wrapper.cfbundle", "index": false },
      ],
    },
  ],
  "targets": [
    {
      "name": "bergr",
      "id": "E9102D293097E5CC000033A3",
      "product": "Products/bergr.app",
      "product-type": "application",
      "dependencies": [
        "BergrLiveActivity",
        "BergrNotificationService",
      ],
      "build-phases": [
        "compile-sources",
        "frameworks",
        "resources",
        {
          "kind": "copy",
          "name": "Embed Foundation Extensions",
          "bundle-base-path": "plugins-directory",
        },
      ],
      "package-product-members": [
        {
          "product-name": "HerdrKit",
          "build-phase": { "build-phase": "frameworks" },
        },
      ],
      "build-settings": {
        "ASSETCATALOG_COMPILER_APPICON_NAME": "AppIcon$(BERGR_ICON_SUFFIX)",
        "ASSETCATALOG_COMPILER_GLOBAL_ACCENT_COLOR_NAME": "AccentColor",
        "CODE_SIGN_ENTITLEMENTS": "Config/bergr.entitlements",
        "CODE_SIGN_STYLE": "Automatic",
        "CURRENT_PROJECT_VERSION": "2",
        "ENABLE_PREVIEWS": "YES",
        "GENERATE_INFOPLIST_FILE": "YES",
        "INFOPLIST_FILE": "Config/Info.plist",
        "INFOPLIST_KEY_CFBundleDisplayName": "bergr$(BERGR_NAME_SUFFIX)",
        "INFOPLIST_KEY_ITSAppUsesNonExemptEncryption": "NO",
        "INFOPLIST_KEY_NSFaceIDUsageDescription": "Face ID unlocks your SSH key when you connect to a machine.",
        "INFOPLIST_KEY_NSLocalNetworkUsageDescription": "Bergr connects over SSH to machines on your local network.",
        "INFOPLIST_KEY_NSLocationAlwaysAndWhenInUseUsageDescription": "Bergr uses a low-accuracy location session only to stay running in the background, so it can alert you when an agent needs you or finishes. Your location is never stored or sent anywhere.",
        "INFOPLIST_KEY_NSLocationWhenInUseUsageDescription": "Bergr uses a low-accuracy location session only to stay running in the background, so it can alert you when an agent needs you or finishes. Your location is never stored or sent anywhere.",
        "INFOPLIST_KEY_UIApplicationSceneManifest_Generation": "YES",
        "INFOPLIST_KEY_UIApplicationSupportsIndirectInputEvents": "YES",
        "INFOPLIST_KEY_UILaunchScreen_Generation": "YES",
        "INFOPLIST_KEY_UISupportedInterfaceOrientations_iPad": "UIInterfaceOrientationPortrait UIInterfaceOrientationPortraitUpsideDown UIInterfaceOrientationLandscapeLeft UIInterfaceOrientationLandscapeRight",
        "INFOPLIST_KEY_UISupportedInterfaceOrientations_iPhone": "UIInterfaceOrientationPortrait UIInterfaceOrientationLandscapeLeft UIInterfaceOrientationLandscapeRight",
        "LD_RUNPATH_SEARCH_PATHS": [
          "$(inherited)",
          "@executable_path/Frameworks",
        ],
        "MARKETING_VERSION": "0.3.0",
        "PRODUCT_BUNDLE_IDENTIFIER": "$(BERGR_BUNDLE_ID_PREFIX).bergr$(BERGR_BUNDLE_ID_SUFFIX)",
        "PRODUCT_NAME": "$(TARGET_NAME)",
        "STRING_CATALOG_GENERATE_SYMBOLS": "YES",
        "SWIFT_APPROACHABLE_CONCURRENCY": "YES",
        "SWIFT_DEFAULT_ACTOR_ISOLATION": "MainActor",
        "SWIFT_EMIT_LOC_STRINGS": "YES",
        "SWIFT_UPCOMING_FEATURE_MEMBER_IMPORT_VISIBILITY": "YES",
        "SWIFT_VERSION": "5.0",
        "TARGETED_DEVICE_FAMILY": "1,2",
      },
    }, {
      "name": "bergrMac",
      "id": "E9102D2C3097E5CC000033A3",
      "product": "Products/Bergr.app",
      "product-type": "application",
      "build-phases": [
        "compile-sources",
        "frameworks",
        "resources",
      ],
      "package-product-members": [
        {
          "product-name": "HerdrKit",
          "build-phase": { "build-phase": "frameworks" },
        }, {
          "product-name": "MacKit",
          "build-phase": { "build-phase": "frameworks" },
        },
      ],
      "build-settings": {
        "ASSETCATALOG_COMPILER_APPICON_NAME": "MacAppIcon$(BERGR_ICON_SUFFIX)",
        "ASSETCATALOG_COMPILER_GLOBAL_ACCENT_COLOR_NAME": "AccentColor",
        "CODE_SIGN_ENTITLEMENTS": "Config/bergrMac.entitlements",
        "CODE_SIGN_STYLE": "Automatic",
        "COMBINE_HIDPI_IMAGES": "YES",
        "CURRENT_PROJECT_VERSION": "2",
        "ENABLE_HARDENED_RUNTIME": "YES",
        "ENABLE_PREVIEWS": "YES",
        "GENERATE_INFOPLIST_FILE": "YES",
        "INFOPLIST_FILE": "Config/Mac-Info.plist",
        "INFOPLIST_KEY_CFBundleDisplayName": "Bergr$(BERGR_NAME_SUFFIX)",
        "INFOPLIST_KEY_NSLocalNetworkUsageDescription": "Bergr connects over SSH to machines on your local network.",
        "LD_RUNPATH_SEARCH_PATHS": [
          "$(inherited)",
          "@executable_path/../Frameworks",
        ],
        "MACOSX_DEPLOYMENT_TARGET": "26.0",
        "MARKETING_VERSION": "0.3.0",
        "PRODUCT_BUNDLE_IDENTIFIER": "$(BERGR_BUNDLE_ID_PREFIX).bergr.mac$(BERGR_BUNDLE_ID_SUFFIX)",
        "PRODUCT_NAME": "Bergr$(BERGR_NAME_SUFFIX)",
        "SDKROOT": "macosx",
        "STRING_CATALOG_GENERATE_SYMBOLS": "YES",
        "SUPPORTED_PLATFORMS": "macosx",
        "SWIFT_APPROACHABLE_CONCURRENCY": "YES",
        "SWIFT_DEFAULT_ACTOR_ISOLATION": "MainActor",
        "SWIFT_EMIT_LOC_STRINGS": "YES",
        "SWIFT_UPCOMING_FEATURE_MEMBER_IMPORT_VISIBILITY": "YES",
        "SWIFT_VERSION": "5.0",
      },
    }, {
